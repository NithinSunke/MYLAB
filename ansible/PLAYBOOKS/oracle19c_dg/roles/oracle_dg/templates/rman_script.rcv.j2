  ALLOCATE CHANNEL ch2 DEVICE TYPE DISK;
  ALLOCATE CHANNEL ch3 DEVICE TYPE DISK;
  BACKUP DATABASE FORMAT '/mnt/nfs_share/oracle/standby_bkp/{{ primary_db }}/full_backup_%U_%d_%T.bkp';
  BACKUP ARCHIVELOG ALL FORMAT '/mnt/nfs_share/oracle/standby_bkp/{{ primary_db }}/archivelog_%U_%d_%T_%U.bkp';
